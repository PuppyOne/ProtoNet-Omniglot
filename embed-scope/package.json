{
  "name": "embed-scope",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "uv run tauri dev",
    "vite": "vite",
    "vite:build": "tsc -b && vite build",
    "download-py": "bun run ./scripts/download-py.ts",
    "build": "bun run ./scripts/build.ts",
    "setup": "bun install && uv venv --python-preference only-system --clear && uv sync",
    "setup:ci": "bun ci && uv venv --clear && uv sync",
    "prepare": "cd .. && husky embed-scope/.husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,md,mdx,json}": [
      "prettier --write"
    ],
    "*.py": [
      "uv run ruff format",
      "uv run ruff check --fix"
    ]
  },
  "dependencies": {
    "@heroui/react": "^3.0.1",
    "@heroui/styles": "^3.0.1",
    "@rolldown/plugin-babel": "^0.2.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-router": "^1.168.1",
    "@tanstack/react-router-devtools": "^1.166.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-opener": "^2",
    "jotai": "^2.19.0",
    "motion": "^12.38.0",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "tauri-plugin-pytauri-api": "^0.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/line-md": "^1.2.16",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tanstack/eslint-plugin-router": "^1.161.6",
    "@tanstack/router-plugin": "^1.167.2",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "json-schema-to-typescript": "^15.0.4",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "run-script-os": "^1.1.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.0.1"
  }
}
