{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "embed-scope",
  "version": "0.1.0",
  "identifier": "com.zxz.embed-scope",
  "build": {
    "beforeDevCommand": "bun vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run vite:build",
    "frontendDist": "../dist-front",
    "additionalWatchFolders": ["../src-python"],
    "features": ["pytauri/standalone"]
  },
  "app": {
    "windows": [
      {
        "title": "EmbedScope",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      },
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
